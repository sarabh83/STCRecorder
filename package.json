{
  "name": "stc-recorder",
  "productName": "STC Recorder",
  "version": "0.2.0",
  "description": "STC Recorder - very light screen recorder with crash-safe backups",
  "author": "Taha Hosseinpour",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never"
  },
  "build": {
    "appId": "com.sarabh83.starecorder",
    "productName": "STC Recorder",
    "copyright": "Copyright © 2026 Taha Hosseinpour",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "STC-Recorder-Setup-${version}.${ext}",
      "uninstallDisplayName": "STC Recorder"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "STC-Recorder-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "STC Recorder records your voice with the screen when you turn the microphone on.",
        "NSAudioCaptureUsageDescription": "STC Recorder records the computer sound with the screen when you turn computer sound on."
      }
    }
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
